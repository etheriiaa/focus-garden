{
  "manifest_version": 3,
  "name": "better forest",
  "version": "1.0",
  "description": "Gamified focus timer and website blocker.",
  "action": {
    "default_icon": "sprout.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "sprout.png"],
      "matches": ["<all_urls>"]
    }
  ]
}